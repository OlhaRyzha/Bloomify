NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MEDIA_HOST=http://localhost:8000
# Canonical public site URL for SEO (sitemap, robots, canonical, OG tags).
# Local: http://localhost:3000. Production: your real domain, e.g.
# https://your-app.vercel.app. If left empty on Vercel, the deploy's
# production URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Services production values:
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_MEDIA_HOST=/api
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=noop
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/bloomify_support_bot
NOTIFICATION_PUBLISHER_SECRET=
LIQPAY_DEV_FRONTEND_LOCAL_URL=http://localhost:3000
LIQPAY_DEV_CHECKOUT_PATH=/uk/checkout
PLAYWRIGHT_BASE_URL=http://localhost:3100
PLAYWRIGHT_API_URL=http://127.0.0.1:8010
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=

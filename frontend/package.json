{
  "name": "bloomify-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "npm run test:unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e:a11y": "env -u NO_COLOR playwright test e2e/accessibility.spec.ts",
    "test:e2e:visual": "env -u NO_COLOR playwright test e2e/visual-responsive.spec.ts",
    "test:e2e": "env -u NO_COLOR playwright test e2e/app-smoke.spec.ts e2e/visual-responsive.spec.ts",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@mobily/ts-belt": "^3.13.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formik": "^2.4.6",
    "framer-motion": "^12.23.27",
    "immer": "^10.2.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.6",
    "qs": "^6.14.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.23",
    "depcheck": "^1.4.7",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.5",
    "pyright": "^1.1.410",
    "tailwindcss": "^4",
    "ts-prune": "^0.10.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "unimported": "^1.31.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "8.5.14",
    "unimported": {
      "@typescript-eslint/typescript-estree": {
        "minimatch": "9.0.9"
      }
    }
  }
}
